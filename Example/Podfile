use_frameworks!


platform :ios, '15.0'

target 'ZLUIKitPlus_Example' do
  pod 'ZLUIKitPlus', :path => '../'
  pod 'Masonry'
  pod 'Then'
  pod 'SDWebImage'
#  pod 'RxSwift'
#  pod 'Kingfisher'
#  pod 'ZLFlexKit', :path => '../../ZLFlexKit'
#  pod 'Alamofire'
#  pod 'YogaKit'
 pod 'SmartCodable'
  target 'ZLUIKitPlus_Tests' do
    inherit! :search_paths

    pod 'FBSnapshotTestCase'
  end
end

# 统一提升所有 Pod 的最低部署版本，避免新版 Xcode 报 deployment target 过低的错误
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
